# Copy to .env (git-ignored). Everything is optional.

# OpenRouter key for AI rewriting/translation. Without it, party games use the offline generator.
OPENROUTER_API_KEY=
# Local hard cap in USD (default 3.50), below the key's own limit.
# SPEND_CAP_USD=3.5
# OPENROUTER_MODEL=qwen/qwen3.7-flash
# OPENROUTER_FALLBACK_MODEL=anthropic/claude-haiku-5.5

# Where projects and the SQLite database live (default ./data).
# DOBLAJE_DATA=
# PORT=5177
# DOBLAJE_MODELS=                  # speech models cache (default ./models; /data/models in Docker)
# FFMPEG=ffmpeg
# FFPROBE=ffprobe

# ---- on a laptop (studio mode): the HTTPS listener phones join on, over the Wi-Fi ----
# PARTY_PORT=5178                    # `off` disables it
# PARTY_HOST=0.0.0.0

# ---- party server (DOBLAJE_MODE=party; see docs/deployment.md) ----
# Rooms only, for a domain: the phone app, the party API and the rooms' media. Never the studio.
# DOBLAJE_MODE=party
# DOMAIN=bokau.askn.us               # used by docker-compose.yml (PARTY_URL, and Caddy's certificate if you use it)
# PARTY_URL=https://bokau.askn.us    # the address friends open (put in the invite link)
# HOST=0.0.0.0                       # party mode listens on every interface by default
# TRUST_PROXY=2                      # proxies in front (believe their X-Forwarded-For): Dokploy's Traefik + Caddy = 2; 0 = none
# TLS_CERT=/certs/fullchain.pem      # serve HTTPS directly (instead of behind a proxy)
# TLS_KEY=/certs/privkey.pem
# The AI the party games use (suggested lines, scene directions, character cards, the trailer's words, written games):
# a free model first; when it is out of requests or fails, a cheap model that does not refuse crude players.
# Free models on OpenRouter allow 50 requests a day, or 1000 once the account has bought $10 of credits, shared by every
# room on the key, so a busy server leans on the cheap fallback. `pnpm probe:models` measures models on the real prompts.
# PARTY_AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# PARTY_AI_FALLBACK=deepseek/deepseek-v4.1-flash
# Accounts for hosts (docs/accounts.md): only people who open rooms sign in, guests never do. Off by default.
# AUTH_PROVIDER=workos                       # workos | dev (tests only) | unset = anonymous rooms, open library
# WORKOS_API_KEY=sk_...                      # WorkOS dashboard → API keys
# WORKOS_CLIENT_ID=client_...
# WORKOS_COOKIE_PASSWORD=                    # openssl rand -base64 32 (seals the session cookie)
# WORKOS_REDIRECT_URI=                       # default PARTY_URL/auth/callback; register it in WorkOS
# The library's master key: a clip sealed with `pnpm library assign|seal` is stored encrypted (AES-256-GCM, a data key per clip
# wrapped by this key) and decrypted into a room's working folder only while the room exists. Keep it OUT of the data folder and
# back it up separately: without it sealed clips cannot be opened. Or put it in a file: LIBRARY_KEY_FILE=/run/secrets/library_key
# LIBRARY_KEY=                               # openssl rand -base64 32
# LIBRARY_KEY_FILE=/run/secrets/library_key  # or the key in a file (the compose file passes LIBRARY_KEY only)
# PARTY_MAX_ROOMS=20
# PARTY_CREATES_PER_HOUR=12          # rooms one address may open per hour
# PARTY_EMPTY_ROOM_MINUTES=5         # when everyone has left, the room and its media are deleted after this long
# PARTY_RETENTION_HOURS=24           # backstop: a round's project older than this is deleted
# PARTY_TRANSCRIBE=1                 # the server listens to takes itself (downloads a speech model on first use)
