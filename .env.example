# Copy to .env (git-ignored). Everything is optional.

# OpenRouter key for AI rewriting/translation. Without it, party games use the offline generator.
OPENROUTER_API_KEY=
# Local hard cap in USD (default 3.50), below the key's own limit.
# SPEND_CAP_USD=3.5
# OPENROUTER_MODEL=qwen/qwen3.7-flash
# OPENROUTER_FALLBACK_MODEL=anthropic/claude-haiku-5.5

# Where projects and the SQLite database live (default ./data).
# DOBLAJE_DATA=
# PORT=5177
# FFMPEG=ffmpeg
# FFPROBE=ffprobe

# ---- party server (DOBLAJE_MODE=party; see docs/deployment.md) ----
# Rooms only, for a domain: the phone app, the party API and the rooms' media. Never the studio.
# DOBLAJE_MODE=party
# DOMAIN=party.example.com           # used by docker-compose.yml (Caddy gets the certificate)
# PARTY_URL=https://party.example.com  # the address friends open (put in the invite link)
# HOST=0.0.0.0                       # party mode listens on every interface by default
# TRUST_PROXY=1                      # reverse proxies in front (believe their X-Forwarded-For); 0 = none
# TLS_CERT=/certs/fullchain.pem      # serve HTTPS directly (instead of behind a proxy)
# TLS_KEY=/certs/privkey.pem
# PARTY_ORIGINS=https://play.example.com   # the phone app served from another origin (a CDN), comma separated
# PARTY_MAX_ROOMS=20
# PARTY_CREATES_PER_HOUR=12          # rooms one address may open per hour
# PARTY_EMPTY_ROOM_MINUTES=5         # when everyone has left, the room and its media are deleted after this long
# PARTY_RETENTION_HOURS=24           # backstop: a round's project older than this is deleted
# PARTY_TRANSCRIBE=1                 # the server listens to takes itself (downloads a speech model on first use)
