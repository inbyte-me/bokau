# Copy to .env (git-ignored). Everything is optional.

# OpenRouter key for AI rewriting/translation. Without it, party games use the offline generator.
OPENROUTER_API_KEY=
# Local hard cap in USD (default 3.50), below the key's own limit.
# SPEND_CAP_USD=3.5
# OPENROUTER_MODEL=qwen/qwen3.7-flash
# OPENROUTER_FALLBACK_MODEL=anthropic/claude-haiku-5.5

# Where projects and the SQLite database live (default ./data).
# DOBLAJE_DATA=
# PORT=5177
# FFMPEG=ffmpeg
# FFPROBE=ffprobe
