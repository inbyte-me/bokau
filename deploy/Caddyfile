# Caddy inside the compose stack, behind another proxy (Dokploy's Traefik): Traefik owns ports 80/443 and the Let's Encrypt
# certificate and hands plain HTTP to this Caddy, which compresses, caps uploads and proxies to the app. The app serves the phone
# app, the API, the WebSocket (/party/ws) and the rooms' media (behind room tokens, so Caddy does not serve files itself).
{
	# Traefik terminates TLS: Caddy must not try to get certificates of its own
	auto_https off
	servers {
		# believe Traefik's X-Forwarded-For / -Proto (it is on a private network) and append to them, so the app can still
		# tell who the visitor is: client, traefik (that is TRUST_PROXY=2 on the app, one per hop)
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip
	request_body {
		max_size 700MB
	}
	reverse_proxy app:5177 {
		flush_interval -1
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}
}
