# A reverse proxy in front of the party server (the app listens on 127.0.0.1:5177 and speaks plain HTTP).
# TLS (Let's Encrypt, e.g. with certbot) ends here; set TRUST_PROXY=1 and PARTY_URL=https://bokau.askn.us on the app.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl http2;
    server_name bokau.askn.us;
    ssl_certificate     /etc/letsencrypt/live/bokau.askn.us/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bokau.askn.us/privkey.pem;

    # takes (WAV) and the host's rendered mix are large uploads; the result is a large download
    client_max_body_size 700m;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    location / {
        proxy_pass http://127.0.0.1:5177;
        proxy_http_version 1.1;
        # the room's WebSocket (/party/ws)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # one hop: the app trusts the last address (TRUST_PROXY=1)
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name bokau.askn.us;
    return 301 https://$host$request_uri;
}
