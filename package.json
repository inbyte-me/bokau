{
  "name": "doblaje-studio",
  "version": "0.2.0",
  "private": true,
  "description": "Voice-Over & Parody Studio: local dubbing, podcast and party-game studio for video clips",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "pnpm --filter @doblaje/web build",
    "start": "pnpm build && node apps/server/src/main.ts",
    "serve": "node apps/server/src/main.ts",
    "desktop": "pnpm build && pnpm --filter @doblaje/desktop start",
    "desktop:dist": "pnpm build && pnpm --filter @doblaje/desktop dist",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p scripts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "test:e2e": "pnpm build && node --test --test-concurrency=1 \"e2e/*.test.ts\"",
    "test:all": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e",
    "test:live": "LIVE_MIC=1 node --test e2e/live-mic.test.ts",
    "test:live-output": "LIVE_MIC=1 node --test e2e/live-output.test.ts",
    "db:generate": "pnpm --filter @doblaje/db generate",
    "db:check": "pnpm --filter @doblaje/db check",
    "fixtures": "node packages/testkit/src/make-fixtures.ts",
    "doctor": "node scripts/doctor.ts",
    "setup:separation": "bash scripts/setup-separation.sh",
    "watch:hardware": "node scripts/watch-hardware.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@doblaje/testkit": "workspace:*",
    "@types/node": "^24.9.0",
    "typescript": "7.0.2"
  }
}
