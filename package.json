{
  "name": "doblaje-studio",
  "version": "0.1.0",
  "description": "Voice-Over & Parody Studio — local dubbing, parody and party-game studio for video clips",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "fixtures": "node test/fixtures/make.js",
    "test": "node --test \"test/unit/*.test.js\" \"test/api/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.js\""
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@napi-rs/canvas": "^1.0.11"
  },
  "devDependencies": {
    "puppeteer-core": "*"
  }
}
